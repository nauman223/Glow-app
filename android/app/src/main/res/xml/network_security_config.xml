<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: cleartext HTTP is blocked for every domain. Trust system CAs only (no user CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
